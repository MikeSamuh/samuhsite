# Copy to .env.local. Local dev needs none of these set: notify stays off,
# Turnstile is skipped, GA is a no-op and the booking embed shows a placeholder.

# on or off. Unset means on in production and off in local dev
LEAD_NOTIFY=
# Who receives every lead. hello@samuh.work at launch (the client, 12 Oct), your own address on preview
LEAD_NOTIFY_TO=
# Copied on every lead. mike@samuh.work at launch
LEAD_NOTIFY_CC=
# Resend API key for the notify email. Server only
RESEND_API_KEY=
# Sender address. site@samuh.work once the domain is verified in Resend
RESEND_FROM=
# Clarify CRM API key. Server only, never NEXT_PUBLIC_. Unset until Jake cuts one
CLARIFY_API_KEY=
# Clarify workspace slug, from their login URL
CLARIFY_WORKSPACE=
# Cloudflare Turnstile site key. The widget renders nothing without it
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret. /api/lead skips verification without it
TURNSTILE_SECRET_KEY=
# Google Calendar appointment schedule link for the /talk booking embed
NEXT_PUBLIC_BOOKING_URL=
# GA4 measurement ID. track() is a no-op without it
NEXT_PUBLIC_GA_ID=
