# Copy to .env.local. Local dev needs none of these set: notify stays off,
# Turnstile is skipped, GA is a no-op and the booking embed shows a placeholder.

# on or off. Unset means on in production and off in local dev
LEAD_NOTIFY=
# Who receives every lead. hello@samuh.work at launch (the client, 12 Oct), your own address on preview
LEAD_NOTIFY_TO=
# Copied on every lead. mike@samuh.work at launch
LEAD_NOTIFY_CC=
# Resend API key for the notify email. Server only
RESEND_API_KEY=
# Sender address. site@samuh.work once the domain is verified in Resend
RESEND_FROM=
# Clarify CRM API key. Server only, never NEXT_PUBLIC_. Mike supplied one on
# 13 Oct; it lives in .env.local here and in Vercel's env for production
CLARIFY_API_KEY=
# Clarify workspace slug, from their login URL (app.clarify.ai/<slug>/...).
# Both must be set for leads to reach the CRM; the key alone logs an error
CLARIFY_WORKSPACE=
# Cloudflare Turnstile site key. The widget renders nothing without it
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret. /api/lead skips verification without it
TURNSTILE_SECRET_KEY=
# Google Calendar appointment schedule link for the /talk booking embed
NEXT_PUBLIC_BOOKING_URL=
# GA4 measurement ID. track() is a no-op without it
NEXT_PUBLIC_GA_ID=

# ---- Admin panel, /admin. See docs/admin.md ----
# Who may sign in. Comma separated, case does not matter
ADMIN_EMAILS=
# Signs the session cookie. Any long random string, 32+ characters. Required in
# production; local dev falls back to a fixed dev secret
ADMIN_SESSION_SECRET=
# Where sign-in links point. Unset uses the request's own origin; set it on
# production so links never carry a preview URL
ADMIN_ORIGIN=
# The admin's document store: page content, blog posts, sign-in tokens. From
# the Upstash Redis integration in the Vercel Marketplace (it may write the
# KV_REST_API_* pair instead; both names work). Unset, the admin saves to
# .data/ on this machine, which is fine for local dev only
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Image uploads from the admin go to Vercel Blob. Unset in local dev they go to
# public/uploads/
BLOB_READ_WRITE_TOKEN=
# The Analytics tab reads GA4 with a service account that is a Viewer on the
# property. The key is the JSON file as one line, or base64 of it
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_KEY=
# Optional: the project's Web Analytics page in the Vercel dashboard, for the
# button in the Analytics tab
VERCEL_ANALYTICS_URL=
